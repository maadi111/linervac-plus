# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app: not secret.
EXPO_PUBLIC_MQTT_URL=wss://mqtt.linervac.com/mqtt
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=
# Dev builds only: let login fall back to a local session if the API login returns 404
EXPO_PUBLIC_ALLOW_LOCAL_AUTH=false
